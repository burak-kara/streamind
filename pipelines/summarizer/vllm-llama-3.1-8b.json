{
  "name": "summarizer",
  "type": "proc",
  "mark": "summarizer_vllm",
  "configuration": {
    "model_name": "./models/llama-3.1-8b-instruct",
    "prompt_template_file": "summarize_prompt.txt",
    "dtype": "bfloat16",
    "gpu_memory_utilization": 0.85,
    "max_model_len": 2048,
    "max_tokens": 256,
    "temperature": 0.3,
    "top_p": 0.9,
    "repetition_penalty": 1.05,
    "enforce_eager": false
  }
}
