# AI assistants – local overrides only
.claude/**/*.local.*
.claude/**/*.lock
.cursor
.remember/
tmp/

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Local configuration files
*.local.*

# Git worktrees
.worktrees/

# SSL certificates
**/*.pem

# IDE / Editor
.idea
.vscode

# macOS
.DS_Store
.AppleDouble
.LSOverride

