{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys; d=json.load(sys.stdin); fp=d.get('tool_input',{}).get('file_path',''); print(json.dumps({'continue':False,'stopReason':'docs/datasets/ is excluded from context — large dataset files, do not read.'})) if 'docs/datasets' in fp else None\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run pytest tests/ -x -q 2>&1 | tail -20"
          },
          {
            "type": "command",
            "command": "python3 -c \"import json; json.load(open('pipelines/config.json')); print('config.json: OK')\" 2>&1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
